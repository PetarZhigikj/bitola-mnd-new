<aside class="mnd-detail-sidebar">


    <!-- =====================================================
         LATEST NEWS
    ====================================================== -->

    <div class="mnd-detail-sidebar-widget">

        <h3 class="mnd-detail-sidebar-title">
            Новости
        </h3>


        <div class="mnd-detail-sidebar-news">

            <% if (
                sidebarNews &&
                sidebarNews.length
            ) { %>

                <% sidebarNews.forEach(function(newsItem) { %>

                    <article class="mnd-detail-sidebar-news-item">


                        <% if (newsItem.image) { %>

                            <a
                                href="/novosti/<%= newsItem.id %>"
                                class="mnd-detail-sidebar-news-image"
                            >

                                <img
                                    src="<%= newsItem.image %>"
                                    alt="<%= newsItem.title %>"
                                >

                            </a>

                        <% } %>


                        <div class="mnd-detail-sidebar-news-content">

                            <a
                                href="/novosti/<%= newsItem.id %>"
                                class="mnd-detail-sidebar-news-title"
                            >
                                <%= newsItem.title %>
                            </a>


                            <span class="mnd-detail-sidebar-news-date">

                                <%= new Date(
                                    newsItem.createdAt
                                ).toLocaleDateString(
                                    'mk-MK',
                                    {
                                        day:
                                            '2-digit',

                                        month:
                                            '2-digit',

                                        year:
                                            'numeric'
                                    }
                                ) %>

                            </span>

                        </div>

                    </article>

                <% }); %>

            <% } else { %>

                <p class="mnd-detail-sidebar-empty">
                    Нема новости.
                </p>

            <% } %>

        </div>


        <a
            href="/novosti"
            class="mnd-detail-sidebar-all"
        >
            Сите новости

            <i class="bx bx-right-arrow-alt"></i>
        </a>

    </div>



