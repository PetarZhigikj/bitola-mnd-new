<header class="mnd-inner-header">

    <div class="mnd-inner-header-container">


        <!-- =================================================
             LOGO
        ================================================== -->

        <div class="mnd-inner-header-logo">

            <a href="/">

                <img style="width: 82px;"
                    src="/images/MND_logo.png"
                    alt="Македонско научно друштво - Битола"
                >

            </a>

        </div>



        <!-- =================================================
             RIGHT SIDE
        ================================================== -->

        <div class="mnd-inner-header-navigation">


            <!-- SEARCH -->

            <form
                class="mnd-header-search"
                @submit.prevent="submitSearch"
            >

                <button
                    type="submit"
                    class="mnd-header-search-button"
                    aria-label="Пребарај"
                >
                    <i class="bx bx-search"></i>
                </button>


                <input
                    type="text"
                    v-model="searchQuery"
                    placeholder="Пребарај"
                    aria-label="Пребарај"
                >

            </form>



            <!-- =================================================
                 NAVIGATION
            ================================================== -->

            <nav class="mnd-inner-main-nav">


                <!-- ЗА МНД -->

                <div class="mnd-inner-nav-item mnd-inner-nav-dropdown">

                    <a
                        href="/za-mnd"
                        class="mnd-inner-nav-link"
                    >
                        ЗА МНД

                        <i class="bx bx-chevron-down"></i>
                    </a>


                    <div class="mnd-inner-dropdown">

                        <a href="/za-mnd/osnovni-informacii">
                            Основни информации
                        </a>

                        <a href="/za-mnd/istorijat">
                            Историјат
                        </a>

                        <a href="/za-mnd/lica-za-kontakt">
                            Лица за контакт
                        </a>

                        <a href="/za-mnd/rakovodna-struktura">
                            Раководна структура
                        </a>

                    </div>

                </div>



                <!-- ОДДЕЛЕНИЈА -->

                <div class="mnd-inner-nav-item mnd-inner-nav-dropdown">

                    <a
                        
                        class="mnd-inner-nav-link"
                    >
                        ОДДЕЛЕНИЈА

                        <i class="bx bx-chevron-down"></i>
                    </a>


                    <div class="mnd-inner-dropdown mnd-inner-dropdown-wide">

                        <a href="/oddelnija/istorisko-geografski-nauki">
                            Одделение за историско-географски науки
                        </a>

                        <a href="/oddelnija/lingvistika-i-literatura">
                            Одделение за лингвистика и литература
                        </a>

                        <a href="/oddelnija/opstestveni-nauki">
                            Одделение за општествени науки
                        </a>

                        <a href="/oddelnija/pravni-nauki">
                            Одделение за правни науки
                        </a>

                        <a href="/oddelnija/primeneti-nauki-i-medicina">
                            Одделение за применети науки и медицина
                        </a>

                        <a href="/oddelnija/prirodni-nauki">
                            Одделение за природни науки
                        </a>

                        <a href="/oddelnija/tehnicki-nauki">
                            Одделение за технички науки
                        </a>

                        <a href="/oddelnija/umetnost">
                            Одделение за уметност
                        </a>


                        <div class="mnd-inner-dropdown-divider"></div>


                        <a
                            href="/clenovi"
                            class="mnd-inner-dropdown-highlight"
                        >
                            Сите членови

                            <i class="bx bx-right-arrow-alt"></i>
                        </a>

                    </div>

                </div>



                <!-- ПУБЛИКАЦИИ -->

                <div class="mnd-inner-nav-item">

                    <a
                        href="/publikacii"
                        class="mnd-inner-nav-link"
                    >
                        ПУБЛИКАЦИИ
                    </a>
                
                </div>



                <!-- DIRECT LINKS -->

                <div class="mnd-inner-nav-item">

                    <a
                        href="/oglasi"
                        class="mnd-inner-nav-link"
                    >
                        ОГЛАСИ
                    </a>

                </div>


                <div class="mnd-inner-nav-item">

                    <a
                        href="/centri"
                        class="mnd-inner-nav-link"
                    >
                        ЦЕНТРИ
                    </a>

                </div>


                <div class="mnd-inner-nav-item">

                    <a
                        href="/kontakt"
                        class="mnd-inner-nav-link mnd-inner-contact-link"
                    >
                        КОНТАКТ
                    </a>

                </div>

            </nav>



            <!-- MOBILE BUTTON -->

            <button
                class="mnd-inner-mobile-menu-btn"
                type="button"
                aria-label="Отвори мени"
                :aria-expanded="mobileMenuOpen ? 'true' : 'false'"
                @click="toggleMobileMenu"
            >
                <i
                    :class="
                        mobileMenuOpen
                            ? 'bx bx-x'
                            : 'bx bx-menu'
                    "
                ></i>
            </button>


        </div>

    </div>

</header>