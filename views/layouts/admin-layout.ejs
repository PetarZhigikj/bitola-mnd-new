<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        <%= typeof pageTitle !== 'undefined'
            ? pageTitle + ' | MND Admin'
            : 'MND Admin'
        %>
    </title>

    <link
        rel="stylesheet"
        href="/styles/admin.css"
    >

    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >
    <link
    href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css"
    rel="stylesheet"
>

<link
    rel="icon"
    type="image/jpeg"
    href="/images/favicon.jpg"
>

</head>

<body
    data-admin-page="<%= adminPage || '' %>"
>

    <div
        id="adminApp"
        class="admin-layout"
    >

        <!-- =============================================
             SIDEBAR
        ============================================== -->
        <aside class="admin-sidebar">

            <div class="admin-sidebar-logo">

                <a href="/admin">

                    <!-- <img
                        src="/images/logo.png"
                        alt="MND Bitola"
                    > -->

                </a>

            </div>


            <nav class="admin-sidebar-nav">

                <a
                    href="/admin"
                    class="<%= adminPage === 'dashboard' ? 'active' : '' %>"
                >
                    <i class="bx bx-grid-alt"></i>

                    Dashboard
                </a>



                <a
                href="/admin/clenovi"
                :class="{
                    active:
                        currentAdminPage === 'clenovi'
                }"
            >
                <i class="bx bx-group"></i>
            
                <span>
                    Членови
                </span>
             </a>

             <a
                href="/admin/za-mnd"
                :class="{
                    active:
                        currentAdminPage === 'za-mnd'
                }"
            >

                <i class="bx bx-info-circle"></i>

                <span>
                    За МНД
                </span>

            </a>







                <!-- <a
                    href="/admin/journal"
                    class="<%= adminPage === 'journal' ? 'active' : '' %>"
                >
                    <i class="bx bx-book-open"></i>

                    Современи дијалози
                </a> -->

                <a
                    href="/admin/publikacii"
                    :class="{
                        active:
                            currentAdminPage === 'publikacii'
                    }"
                >
                    <i class="bx bx-book"></i>

                    <span>
                        Публикации
                    </span>
                </a>


                <a
                    href="/admin/sovremeni-dijalozi"
                    :class="{
                        active:
                            currentAdminPage === 'sovremeni-dijalozi'
                    }"
                >
                    <i class="bx bx-book-open"></i>

                    <span>
                        Современи дијалози
                    </span>
                </a>


                <a
                    href="/admin/drugi-prilozi"
                    :class="{
                        active:
                            currentAdminPage === 'drugi-prilozi'
                    }"
                >
                    <i class="bx bx-file"></i>

                    <span>
                        Други прилози
                    </span>
                </a>


                <a
                    href="/admin/oglasi"
                    :class="{
                        active:
                            currentAdminPage === 'oglasi'
                    }"
                >
                <i class="bx bx-book"></i>

                    <span>
                        Огласи
                    </span>
                </a>
                
                <a
                    href="/admin/novosti"
                    :class="{
                        active:
                            currentAdminPage === 'novosti'
                    }"
                >
                    <i class="bx bx-news"></i>

                    <span>
                        Новости
                    </span>
                </a>
                <a
                    href="/admin/centri"
                    :class="{
                        active:
                            currentAdminPage === 'centri'
                    }"
                >
                    <i class="bx bx-building"></i>

                    <span>
                        Центри
                    </span>
                </a>

                <a
                    href="/admin/nagradi"
                    :class="{
                        active:
                            currentAdminPage === 'nagradi'
                    }"
                >
                    <i class="bx bx-award"></i>

                    <span>
                        Награди
                    </span>
                </a>


            

            </nav>


            <button
                type="button"
                class="admin-sidebar-logout"
                @click="adminLogout"
            >
                <i class="bx bx-log-out"></i>

                Logout
            </button>

        </aside>


        <!-- =============================================
             MAIN CONTENT
        ============================================== -->
        <main class="admin-main">

            <header class="admin-topbar">

                <h1>
                    <%= pageTitle || 'Admin' %>
                </h1>


                <a
                    href="/"
                    target="_blank"
                    class="admin-view-site"
                >
                    <i class="bx bx-link-external"></i>

                    View Website
                </a>

            </header>


            <!-- GLOBAL MESSAGE -->
            <div
                v-if="adminMessage"
                class="admin-message"
                :class="'admin-message-' + adminMessageType"
            >
                {{ adminMessage }}
            </div>


            <section class="admin-content">

                <%- body %>

            </section>

        </main>

    </div>


    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    
    <script src="/js/adminScript.js"></script>

</body>

</html>