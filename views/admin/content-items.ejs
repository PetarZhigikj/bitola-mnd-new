<div
    id="adminContentPage"
    class="admin-manage-page"
    data-content-type="<%= contentType %>"
    data-content-title="<%= contentPageTitle %>">

    <% if (contentType === 'publikacija') { %>

        <div v-if="contentPageMode === 'list'" class="admin-form-card admin-publication-landing-settings">
    
            <div class="admin-page-header">
    
                <div>
    
                    <h3>
                        Фотографии за страницата Публикации
                    </h3>
    
                    <p>
                        Овие фотографии се прикажуваат
                        на главната страница Публикации.
                    </p>
    
                </div>
    
            </div>
    
    
    
            <div class="admin-publication-landing-grid">


                <!-- =====================================================
                     ИЗДАНИЈА
                ====================================================== -->
            
                <div class="admin-publication-image-card">
            
                    <div class="admin-publication-image-card-header">
            
                        <div>
            
                            <strong>
                                Изданија
                            </strong>
            
                            <small>
                                Фотографија за Изданија
                            </small>
            
                        </div>
            
            
                        <button
                            v-if="publicationLandingPreviews.publications"
                            type="button"
                            class="admin-btn admin-btn-small"
                            @click="
                                togglePublicationLandingPreview(
                                    'publications'
                                )
                            "
                        >
            
                            <i
                                :class="
                                    publicationLandingPreviewOpen.publications
                                        ? 'bx bx-hide'
                                        : 'bx bx-show'
                                "
                            ></i>
            
                            {{
                                publicationLandingPreviewOpen.publications
                                    ? 'Сокриј'
                                    : 'Прикажи'
                            }}
            
                        </button>
            
                    </div>
            
            
                    <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        @change="
                            handlePublicationLandingImage(
                                $event,
                                'publications'
                            )
                        "
                    >
            
            
                    <div
                        v-if="
                            publicationLandingPreviews.publications &&
                            publicationLandingPreviewOpen.publications
                        "
                        class="admin-publication-landing-preview-wrapper"
                    >
            
                        <img
                            :src="
                                publicationLandingPreviews.publications
                            "
                            class="admin-publication-landing-preview"
                            alt="Изданија"
                        >
            
                    </div>
            
                </div>
            
            
            
                <!-- =====================================================
                     СОВРЕМЕНИ ДИЈАЛОЗИ
                ====================================================== -->
            
                <div class="admin-publication-image-card">
            
                    <div class="admin-publication-image-card-header">
            
                        <div>
            
                            <strong>
                                Современи дијалози
                            </strong>
            
                            <small>
                                Фотографија за Современи дијалози
                            </small>
            
                        </div>
            
            
                        <button
                            v-if="publicationLandingPreviews.dialogues"
                            type="button"
                            class="admin-btn admin-btn-small"
                            @click="
                                togglePublicationLandingPreview(
                                    'dialogues'
                                )
                            "
                        >
            
                            <i
                                :class="
                                    publicationLandingPreviewOpen.dialogues
                                        ? 'bx bx-hide'
                                        : 'bx bx-show'
                                "
                            ></i>
            
                            {{
                                publicationLandingPreviewOpen.dialogues
                                    ? 'Сокриј'
                                    : 'Прикажи'
                            }}
            
                        </button>
            
                    </div>
            
            
                    <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        @change="
                            handlePublicationLandingImage(
                                $event,
                                'dialogues'
                            )
                        "
                    >
            
            
                    <div
                        v-if="
                            publicationLandingPreviews.dialogues &&
                            publicationLandingPreviewOpen.dialogues
                        "
                        class="admin-publication-landing-preview-wrapper"
                    >
            
                        <img
                            :src="
                                publicationLandingPreviews.dialogues
                            "
                            class="admin-publication-landing-preview"
                            alt="Современи дијалози"
                        >
            
                    </div>
            
                </div>
            
            
            
                <!-- =====================================================
                     ДРУГИ ПРИЛОЗИ
                ====================================================== -->
            
                <div class="admin-publication-image-card">
            
                    <div class="admin-publication-image-card-header">
            
                        <div>
            
                            <strong>
                                Други прилози
                            </strong>
            
                            <small>
                                Фотографија за Други прилози
                            </small>
            
                        </div>
            
            
                        <button
                            v-if="publicationLandingPreviews.other"
                            type="button"
                            class="admin-btn admin-btn-small"
                            @click="
                                togglePublicationLandingPreview(
                                    'other'
                                )
                            "
                        >
            
                            <i
                                :class="
                                    publicationLandingPreviewOpen.other
                                        ? 'bx bx-hide'
                                        : 'bx bx-show'
                                "
                            ></i>
            
                            {{
                                publicationLandingPreviewOpen.other
                                    ? 'Сокриј'
                                    : 'Прикажи'
                            }}
            
                        </button>
            
                    </div>
            
            
                    <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        @change="
                            handlePublicationLandingImage(
                                $event,
                                'other'
                            )
                        "
                    >
            
            
                    <div
                        v-if="
                            publicationLandingPreviews.other &&
                            publicationLandingPreviewOpen.other
                        "
                        class="admin-publication-landing-preview-wrapper"
                    >
            
                        <img
                            :src="
                                publicationLandingPreviews.other
                            "
                            class="admin-publication-landing-preview"
                            alt="Други прилози"
                        >
            
                    </div>
            
                </div>
            
            
            </div>
    
    
    
            <div class="admin-form-actions">
    
                <button
                    type="button"
                    class="admin-btn admin-btn-primary"
                    :disabled="savingPublicationLanding"
                    @click="savePublicationLanding"
                >
    
                    <i class="bx bx-save"></i>
    
                    {{
                        savingPublicationLanding
                            ? 'Се зачувува...'
                            : 'Зачувај фотографии'
                    }}
    
                </button>
    
            </div>
    
        </div>
    
    <% } %>

    <!-- =====================================================
         LIST
    ====================================================== -->

    <template
        v-if="contentPageMode === 'list'"
    >

        <div class="admin-page-header">

            <div>

                <h2>
                    <%= contentPageTitle %>
                </h2>

                <p>
                    Управување со
                    <%= contentPageTitle.toLowerCase() %>.
                </p>

            </div>


            <button
                type="button"
                class="admin-btn admin-btn-primary"
                @click="openCreateContentItem"
            >
                <i class="bx bx-plus"></i>

                Додај
            </button>

        </div>



        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>
                            Наслов
                        </th>
                        
                        
                        <% if (contentType !== 'novost') { %>
                        
                            <th>
                                Документ
                            </th>
                        
                        <% } %>
                        
                        
                        <th>
                            Акции
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr
                        v-for="item in contentItems"
                        :key="item.id"
                    >

                        <td>
                            <strong>
                                {{ item.title }}
                            </strong>
                        </td>


                        <% if (contentType !== 'novost') { %>

                            <td>
                        
                                <span v-if="item.attachmentName">
                                    {{ item.attachmentName }}
                                </span>
                        
                                <span v-else>
                                    —
                                </span>
                        
                            </td>
                        
                        <% } %>


                        <td>

                            <div class="admin-table-actions">

                                <button
                                    type="button"
                                    class="admin-btn admin-btn-small"
                                    @click="openEditContentItem(item)"
                                >
                                    <i class="bx bx-edit"></i>

                                    Измени
                                </button>


                                <button
                                    type="button"
                                    class="admin-btn admin-btn-small admin-btn-danger"
                                    @click="deleteContentItem(item)"
                                >
                                    <i class="bx bx-trash"></i>

                                    Избриши
                                </button>

                            </div>

                        </td>

                    </tr>


                    <tr
                        v-if="
                            !loadingContentItems &&
                            !contentItems.length
                        "
                    >

                        <td
                            colspan="3"
                            class="admin-empty-state"
                        >
                            Нема содржина.
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </template>

        <!-- =====================================================
         FORM
    ====================================================== -->

    <template v-else>

        <div class="admin-form-header">

            <button
                type="button"
                class="admin-back-btn"
                @click="closeContentForm"
            >
                <i class="bx bx-arrow-back"></i>

                Назад
            </button>


            <h2>

                {{
                    editingContentItemId
                        ? 'Измени'
                        : 'Додај'
                }}

                <%= contentPageTitle %>

            </h2>

        </div>



        <form
            class="admin-form-card"
            @submit.prevent="saveContentItem"
        >


            <!-- TITLE -->

            <div class="admin-form-group">

                <label>
                    Наслов *
                </label>


                <input
                    type="text"
                    v-model="contentForm.title"
                    required
                >

            </div>

            <% if (contentType === 'novost') { %>

                <div class="admin-form-group">
            
                    <label class="admin-checkbox-label">
            
                        <input
                            type="checkbox"
                            v-model="contentForm.isEvent"
                        >
            
                        <span>
                            Настан
                        </span>
            
                    </label>
            
            
                    <small class="admin-form-help">
                        Ако е означено, новоста ќе се прикажува и во страницата Настани.
                    </small>
            
                </div>
            
            <% } %>



            <!-- IMAGE -->

            <div class="admin-form-group">

                <label>
                    Фотографија
                </label>


                <input
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    @change="handleContentImageChange"
                >


                <div
                    v-if="contentImagePreview"
                    class="admin-content-image-preview"
                >

                    <img
                        :src="contentImagePreview"
                        alt="Преглед"
                    >


                    <button
                        type="button"
                        class="admin-btn admin-btn-small admin-btn-danger"
                        @click="removeContentImage"
                    >
                        Отстрани фотографија
                    </button>

                </div>

            </div>



            <!-- RICH TEXT -->

            <div class="admin-form-group">

                <label>
                    Содржина
                </label>


                <div
                    id="contentRichTextEditor"
                    class="admin-rich-text-editor"
                ></div>

            </div>



            <!-- ATTACHMENT -->

            <% if (contentType !== 'novost') { %>

                <!-- ATTACHMENT -->
            
                <div class="admin-form-group">
            
                    <label>
                        Прикачен документ
                    </label>
            
            
                    <input
                        type="file"
                        @change="handleContentAttachmentChange"
                    >
            
            
                    <div
                        v-if="contentAttachmentName"
                        class="admin-content-attachment-preview"
                    >
            
                        <i class="bx bx-file"></i>
            
            
                        <span>
                            {{ contentAttachmentName }}
                        </span>
            
            
                        <button
                            type="button"
                            class="admin-btn admin-btn-small admin-btn-danger"
                            @click="removeContentAttachment"
                        >
                            Отстрани
                        </button>
            
                    </div>
            
                </div>
            
            <% } %>



            <p
                v-if="contentFormError"
                class="admin-form-error"
            >
                {{ contentFormError }}
            </p>



            <div class="admin-form-actions">

                <button
                    type="button"
                    class="admin-btn"
                    @click="closeContentForm"
                >
                    Откажи
                </button>


                <button
                    type="submit"
                    class="admin-btn admin-btn-primary"
                    :disabled="savingContentItem"
                >

                    <i class="bx bx-save"></i>

                    {{
                        savingContentItem
                            ? 'Се зачувува...'
                            : 'Зачувај'
                    }}

                </button>

            </div>

        </form>

    </template>

</div>


