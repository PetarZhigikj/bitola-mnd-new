<section class="mnd-contact-page">

    <div class="mnd-page-container">


        <div class="mnd-contact-card">


            <!-- =================================================
                 FORM
            ================================================== -->

            <div class="mnd-contact-form-column">

                <div class="mnd-contact-heading">

                    <h1>
                        Испрати порака
                    </h1>

                    <p>
                        Контактирајте нè преку формата
                        и ќе ви одговориме во најкраток можен рок.
                    </p>

                </div>


                <form
                    class="mnd-contact-form"
                    @submit.prevent="submitContactForm"
                >


                    <!-- Honeypot -->

                    <input
                        type="text"
                        v-model="contactForm.website"
                        tabindex="-1"
                        autocomplete="off"
                        class="mnd-contact-honeypot"
                        aria-hidden="true"
                    >


                    <div class="mnd-contact-field">

                        <label for="contactSubject">
                            Наслов *
                        </label>

                        <input
                            id="contactSubject"
                            type="text"
                            v-model="contactForm.subject"
                            placeholder="Наслов на пораката"
                            maxlength="200"
                            required
                        >

                    </div>


                    <div class="mnd-contact-field">

                        <label for="contactName">
                            Име и презиме *
                        </label>

                        <input
                            id="contactName"
                            type="text"
                            v-model="contactForm.name"
                            placeholder="Вашето име и презиме"
                            maxlength="150"
                            required
                        >

                    </div>


                    <div class="mnd-contact-field">

                        <label for="contactInfo">
                            Контакт *
                        </label>

                        <input
                            id="contactInfo"
                            type="text"
                            v-model="contactForm.contact"
                            placeholder="Email или телефонски број"
                            maxlength="200"
                            required
                        >

                    </div>


                    <div class="mnd-contact-field">

                        <label for="contactMessage">
                            Порака *
                        </label>

                        <textarea
                            id="contactMessage"
                            v-model="contactForm.message"
                            placeholder="Напишете ја вашата порака..."
                            rows="7"
                            maxlength="5000"
                            required
                        ></textarea>

                    </div>


                    <p
                        v-if="contactFormError"
                        class="mnd-contact-form-message mnd-contact-form-error"
                    >
                        {{ contactFormError }}
                    </p>


                    <p
                        v-if="contactFormSuccess"
                        class="mnd-contact-form-message mnd-contact-form-success"
                    >
                        {{ contactFormSuccess }}
                    </p>


                    <button
                        type="submit"
                        class="mnd-contact-submit"
                        :disabled="sendingContactForm"
                    >

                        {{
                            sendingContactForm
                                ? 'СЕ ИСПРАЌА...'
                                : 'ИСПРАТИ ПОРАКА'
                        }}

                    </button>

                </form>

            </div>



            <!-- =================================================
                 MAP
            ================================================== -->

            <div class="mnd-contact-map-column">

                <div class="mnd-contact-map">

                    <iframe
                        src="https://www.google.com/maps?q=%D0%9F%D0%B5%D1%86%D0%B5%20%D0%9C%D0%B0%D1%82%D0%B8%D1%87%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%2039%2C%20%D0%91%D0%B8%D1%82%D0%BE%D0%BB%D0%B0%2C%20%D0%A1%D0%B5%D0%B2%D0%B5%D1%80%D0%BD%D0%B0%20%D0%9C%D0%B0%D0%BA%D0%B5%D0%B4%D0%BE%D0%BD%D0%B8%D1%98%D0%B0&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Локација на Македонско научно друштво Битола"
                    ></iframe>

                </div>


                <div class="mnd-contact-location">

                    <div class="mnd-contact-location-icon">

                        <i class="bx bx-map"></i>

                    </div>


                    <div>

                        <h3>
                            Македонско научно друштво - Битола
                        </h3>

                        <p>
                            Пеце Матичевски бр. 39,
                            п. фах 145, Битола
                        </p>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>