<section
    class="mnd-departments-section"
    id="departments"
>

    <div class="mnd-decoration-ring mnd-decoration-ring-departments"></div>


    <div class="mnd-page-container">

        <div class="mnd-section-heading">

            <h2>
                Одделенија
            </h2>

        </div>


        <div class="mnd-department-cards">

            <a
                v-for="department in departments"
                :key="department.slug"
                class="mnd-department-card"
                :href="'/oddelnija/' + department.slug"
            >
        
                <div class="mnd-department-icon">
                    <i :class="department.icon"></i>
                </div>
        
                <h3>
                    {{ department.name }}
                </h3>
        
                <div class="mnd-department-link">
                    Дознај повеќе
                    <i class="bx bx-right-arrow-alt"></i>
                </div>
        
            </a>
        
        </div>

    </div>

</section>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->
    <section class="mnd-statistics-section">

        <div class="mnd-page-container">
    
            <div class="mnd-statistics-grid">
    
                <div class="mnd-stat-card">
    
                    <i class="bx bx-group"></i>
    
                    <strong>254+</strong>
    
                    <span>АКТИВНИ ЧЛЕНОВИ</span>
    
                </div>
    
    
                <div class="mnd-stat-card">
    
                    <i class="bx bx-building-house"></i>
    
                    <strong>8</strong>
    
                    <span>ЦЕНТРИ</span>
    
