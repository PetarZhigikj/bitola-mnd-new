                <div class="mnd-stat-card">
    
                    <i class="bx bx-category-alt"></i>
    
                    <strong>8</strong>
    
                    <span>ОДДЕЛЕНИЈА</span>
    
                </div>
    
    
                <div class="mnd-stat-card">
    
                    <i class="bx bx-history"></i>
    
                    <strong class="mnd-stat-years">
                        60 години
                    </strong>
    
                    <span>ПОСТОЕЊЕ</span>
    
                </div>
    
            </div>
    
        </div>
    
    </section>

