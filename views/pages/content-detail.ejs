<div class="mnd-content-detail-page">

    <section class="mnd-content-detail-section">

        <div class="mnd-content-detail-container">

            <div class="mnd-detail-page-layout">


                <!-- =================================================
                     MAIN CONTENT
                ================================================== -->

                <main class="mnd-detail-page-main">


                    <!-- BACK -->

                    <a
                        href="<%= basePath %>"
                        class="mnd-content-back"
                    >

                        <i class="bx bx-left-arrow-alt"></i>

                        <%= listingTitle %>

                    </a>



                    <!-- TITLE -->

                    <div class="mnd-content-detail-heading">

                        <h1>
                            <%= item.title %>
                        </h1>

                    </div>

                    <% if (item.createdAt) { %>

                        <div class="mnd-content-detail-date">
                    
                            <i class="bx bx-calendar"></i>
                    
                            <span>
                                <%= new Intl.DateTimeFormat(
                                    'mk-MK',
                                    {
                                        day: '2-digit',
                                        month: '2-digit',
                                        year: 'numeric'
                                    }
                                ).format(
                                    new Date(item.createdAt)
                                ) %>
                            </span>
                    
                        </div>
                    
                    <% } %>



                    <!-- IMAGE -->

                    <% if (item.image) { %>

                        <div class="mnd-content-detail-image">

                            <img
                                src="<%= item.image %>"
                                alt="<%= item.title %>"
                            >

                        </div>

                    <% } %>



                    <!-- TEXT -->

                    <% if (item.content) { %>

                        <article class="mnd-rich-content ql-editor">

                            <%- item.content %>

                        </article>

                    <% } %>



                    <!-- ATTACHMENT -->

                    <% if (item.attachmentUrl) {

                        const attachmentName =
                            item.attachmentName ||
                            item.attachmentUrl;

                        const isPdf =
                            item.attachmentMimeType ===
                                'application/pdf' ||
                            attachmentName
                                .toLowerCase()
                                .endsWith('.pdf');

                    %>


                        <div class="mnd-content-attachment">

                            <h2>
                                Документ
                            </h2>


                            <% if (isPdf) { %>

                                <a
                                    href="<%= item.attachmentUrl %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mnd-content-attachment-link"
                                >

                                    <i class="bx bxs-file-pdf"></i>

                                    <span>
                                        <%= attachmentName %>
                                    </span>

                                    <strong>
                                        Отвори PDF
                                    </strong>

                                </a>


                            <% } else { %>

                                <a
                                    href="<%= item.attachmentUrl %>"
                                    download="<%= attachmentName %>"
                                    class="mnd-content-attachment-link"
                                >

                                    <i class="bx bx-download"></i>

                                    <span>
                                        <%= attachmentName %>
                                    </span>

                                    <strong>
                                        Преземи
                                    </strong>

                                </a>

                            <% } %>

                        </div>

                    <% } %>


                </main>



                <!-- =================================================
                     SIDEBAR
                ================================================== -->

                <%- include(
                    '../partials/detail-sidebar',
                    {
                        sidebarNews,
                        sidebarCalendar
                    }
                ) %>


            </div>

        </div>

    </section>

</div>